# Environments
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Data: never commit (download from source; see data/README.md)
data/**
!data/**/
!data/README.md
!data/**/.gitkeep
!data/**/CHECKSUMS.txt

# Papers: copyrighted PDFs stay local
papers/

# Results: commit only small summaries + configs
results/**
!results/**/
!results/**/config.json
!results/**/summary.csv
!results/**/*.md

# Models / large artefacts
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.zip

# OS / editor
.DS_Store
Thumbs.db
.vscode/
*_backup.tex

# LaTeX build files
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
figures/_check/
results/*smoke*/

# small JSON summaries of results (added 2026-10-20)
!results/**/summary.json
!results/**/analysis.json
!results/**/icc_excess.json
!results/**/report.json
!results/**/summary_*.json
!results/**/config_*.json
